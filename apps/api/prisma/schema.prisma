// SC_OFFICE - Schema Prisma Completo
// Banco: PostgreSQL
// ORM: Prisma 5.x

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "fullTextIndex"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  ADMIN
  RH
  GESTOR
  CONSULTA
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

enum Gender {
  MASCULINO
  FEMININO
  OUTRO
  NAO_INFORMADO
}

enum MaritalStatus {
  SOLTEIRO
  CASADO
  DIVORCIADO
  VIUVO
  UNIAO_ESTAVEL
  OUTRO
}

enum DocumentType {
  RG
  CPF
  CTPS
  COMPROVANTE_ENDERECO
  ASO                    // Atestado de Saúde Ocupacional
  CNH
  CERTIFICADO
  CONTRATO
  ADVERTENCIA
  FERIAS
  RESCISAO
  TREINAMENTO
  DIPLOMA
  RESERVISTA
  TITULO_ELEITOR
  FOTO_3X4
  OUTRO
}

enum TemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum TemplateFormat {
  DOCX
  HTML
}

enum DocumentStatus {
  DRAFT
  GENERATED
  SIGNED
  ARCHIVED
  DELETED
}

enum ValidityStatus {
  VALID
  EXPIRING_SOON   // <= 30 days
  CRITICAL        // <= 7 days
  EXPIRED
  NOT_APPLICABLE  // sem data de validade
}

enum AlertType {
  DOCUMENT_EXPIRING
  DOCUMENT_EXPIRED
  COMPLIANCE_INCOMPLETE
  DOCUMENT_PENDING
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  VIEW
  LOGIN
  LOGOUT
  EXPORT
  IMPORT
  PASSWORD_CHANGE
  PASSWORD_RESET
  GENERATE_DOCUMENT
  PREVIEW_DOCUMENT
}

enum FolderType {
  SYSTEM
  USER
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  BOOLEAN
}

// ============================================================
// AUTENTICAÇÃO E USUÁRIOS
// ============================================================

model User {
  id                String     @id @default(cuid())
  name              String     @db.VarChar(200)
  email             String     @unique @db.VarChar(255)
  passwordHash      String     @map("password_hash") @db.VarChar(255)
  role              UserRole   @default(CONSULTA)
  status            UserStatus @default(ACTIVE)
  avatarUrl         String?    @map("avatar_url") @db.VarChar(500)
  lastLoginAt       DateTime?  @map("last_login_at")
  passwordChangedAt DateTime?  @map("password_changed_at")
  mustChangePassword Boolean   @default(false) @map("must_change_password")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  refreshTokens    RefreshToken[]
  passwordResets   PasswordReset[]
  auditLogs        AuditLog[]       @relation("AuditUser")
  createdDocuments GeneratedDocument[] @relation("DocumentCreator")
  uploadedFiles    FileStorage[]    @relation("FileUploader")

  @@index([email])
  @@index([role])
  @@index([status])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique @db.VarChar(500)
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.VarChar(500)
  revokedAt DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model PasswordReset {
  id        String   @id @default(cuid())
  token     String   @unique @db.VarChar(255)
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("password_resets")
}

// ============================================================
// EMPRESA
// ============================================================

model Company {
  id        String  @id @default(cuid())
  name      String  @db.VarChar(200)
  tradeName String? @map("trade_name") @db.VarChar(200)
  cnpj      String  @unique @db.VarChar(18)
  email     String? @db.VarChar(255)
  phone     String? @db.VarChar(20)
  website   String? @db.VarChar(255)
  logoUrl   String? @map("logo_url") @db.VarChar(500)

  // Endereço
  zipCode      String? @map("zip_code") @db.VarChar(9)
  street       String? @db.VarChar(255)
  number       String? @db.VarChar(20)
  complement   String? @db.VarChar(100)
  neighborhood String? @db.VarChar(100)
  city         String? @db.VarChar(100)
  state        String? @db.VarChar(2)
  country      String  @default("BR") @db.VarChar(2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("company")
}

// ============================================================
// ESTRUTURA ORGANIZACIONAL
// ============================================================

model Department {
  id          String  @id @default(cuid())
  name        String  @db.VarChar(100)
  code        String  @unique @db.VarChar(20)
  description String? @db.VarChar(500)
  parentId    String? @map("parent_id")
  managerId   String? @map("manager_id")
  active      Boolean @default(true)
  order       Int     @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent      Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children    Department[] @relation("DepartmentHierarchy")
  positions   Position[]
  employees   Employee[]

  @@index([parentId])
  @@index([code])
  @@map("departments")
}

model Position {
  id           String  @id @default(cuid())
  title        String  @db.VarChar(150)
  code         String  @unique @db.VarChar(20)
  description  String? @db.VarChar(500)
  departmentId String  @map("department_id")
  level        Int     @default(1)
  salaryMin    Decimal? @map("salary_min") @db.Decimal(12, 2)
  salaryMax    Decimal? @map("salary_max") @db.Decimal(12, 2)
  active       Boolean  @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  department Department @relation(fields: [departmentId], references: [id])
  employees  Employee[]

  @@index([departmentId])
  @@index([code])
  @@map("positions")
}

// ============================================================
// FUNCIONÁRIOS
// ============================================================

model Employee {
  id          String         @id @default(cuid())
  matricula   String         @unique @db.VarChar(20)
  status      EmployeeStatus @default(ACTIVE)

  // Dados Pessoais
  fullName      String    @map("full_name") @db.VarChar(200)
  socialName    String?   @map("social_name") @db.VarChar(200)
  cpf           String    @unique @db.VarChar(14)
  rg            String?   @db.VarChar(20)
  rgIssuingBody String?   @map("rg_issuing_body") @db.VarChar(50)
  rgState       String?   @map("rg_state") @db.VarChar(2)
  birthDate     DateTime  @map("birth_date") @db.Date
  gender        Gender    @default(NAO_INFORMADO)
  maritalStatus MaritalStatus @default(SOLTEIRO) @map("marital_status")
  nationality   String    @default("Brasileiro(a)") @db.VarChar(100)
  birthCity     String?   @map("birth_city") @db.VarChar(100)
  birthState    String?   @map("birth_state") @db.VarChar(2)

  // Contato
  email       String  @db.VarChar(255)
  phone       String? @db.VarChar(20)
  cellphone   String? @db.VarChar(20)
  emergencyContact     String? @map("emergency_contact") @db.VarChar(200)
  emergencyPhone       String? @map("emergency_phone") @db.VarChar(20)

  // Endereço
  zipCode      String? @map("zip_code") @db.VarChar(9)
  street       String? @db.VarChar(255)
  number       String? @db.VarChar(20)
  complement   String? @db.VarChar(100)
  neighborhood String? @db.VarChar(100)
  city         String? @db.VarChar(100)
  state        String? @db.VarChar(2)

  // Dados Profissionais
  departmentId String   @map("department_id")
  positionId   String   @map("position_id")
  admissionDate DateTime @map("admission_date") @db.Date
  terminationDate DateTime? @map("termination_date") @db.Date
  salary       Decimal? @db.Decimal(12, 2)
  workSchedule String?  @map("work_schedule") @db.VarChar(100)
  observations String?  @db.Text
  photoUrl     String?  @map("photo_url") @db.VarChar(500)

  // Dados bancários
  bankName     String? @map("bank_name") @db.VarChar(100)
  bankAgency   String? @map("bank_agency") @db.VarChar(20)
  bankAccount  String? @map("bank_account") @db.VarChar(30)
  bankPix      String? @map("bank_pix") @db.VarChar(255)

  // PIS/PASEP
  pis          String? @db.VarChar(14)
  ctps         String? @db.VarChar(20)
  ctpsSerie    String? @map("ctps_serie") @db.VarChar(10)
  ctpsState    String? @map("ctps_state") @db.VarChar(2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  department          Department          @relation(fields: [departmentId], references: [id])
  position            Position            @relation(fields: [positionId], references: [id])
  employeeDocuments   EmployeeDocument[]
  generatedDocuments  GeneratedDocument[]
  dossierFolders      DossierFolder[]
  documentValidity    DocumentValidity[]
  customFieldValues   CustomFieldValue[]
  alerts              Alert[]

  @@index([cpf])
  @@index([matricula])
  @@index([departmentId])
  @@index([positionId])
  @@index([status])
  @@index([fullName])
  @@map("employees")
}

// ============================================================
// DOCUMENTOS DO FUNCIONÁRIO (Uploads pessoais)
// ============================================================

model EmployeeDocument {
  id           String       @id @default(cuid())
  employeeId   String       @map("employee_id")
  type         DocumentType
  name         String       @db.VarChar(255)
  description  String?      @db.VarChar(500)
  fileStorageId String      @map("file_storage_id")
  expiresAt    DateTime?    @map("expires_at")
  verified     Boolean      @default(false)
  verifiedAt   DateTime?    @map("verified_at")
  verifiedBy   String?      @map("verified_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  employee         Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fileStorage      FileStorage        @relation(fields: [fileStorageId], references: [id])
  documentValidity DocumentValidity[]

  @@index([employeeId])
  @@index([type])
  @@map("employee_documents")
}

// ============================================================
// MOTOR DE TEMPLATES
// ============================================================

model Template {
  id          String         @id @default(cuid())
  name        String         @db.VarChar(255)
  description String?        @db.VarChar(500)
  category    String?        @db.VarChar(100)
  format      TemplateFormat
  status      TemplateStatus @default(DRAFT)
  version     Int            @default(1)
  fileStorageId String?      @map("file_storage_id")
  htmlContent   String?      @map("html_content") @db.Text
  variables     Json         @default("[]")
  invalidVariables Json      @default("[]") @map("invalid_variables")
  usageCount  Int            @default(0) @map("usage_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String    @map("created_by")

  fileStorage        FileStorage?         @relation(fields: [fileStorageId], references: [id])
  generatedDocuments GeneratedDocument[]
  templateVersions   TemplateVersion[]
  requirements       TemplateRequirement[]

  @@index([name])
  @@index([category])
  @@index([status])
  @@map("templates")
}

model TemplateVersion {
  id            String @id @default(cuid())
  templateId    String @map("template_id")
  version       Int
  fileStorageId String? @map("file_storage_id")
  htmlContent   String? @map("html_content") @db.Text
  variables     Json   @default("[]")
  changelog     String? @db.VarChar(500)
  createdBy     String  @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")

  template           Template            @relation(fields: [templateId], references: [id], onDelete: Cascade)
  fileStorage        FileStorage?        @relation(fields: [fileStorageId], references: [id])
  generatedDocuments GeneratedDocument[]

  @@unique([templateId, version])
  @@index([templateId])
  @@map("template_versions")
}

// ============================================================
// DOCUMENTOS GERADOS
// ============================================================

model GeneratedDocument {
  id                String         @id @default(cuid())
  name              String         @db.VarChar(255)
  templateId        String         @map("template_id")
  templateVersionId String?        @map("template_version_id")  // Snapshot da versão exata
  employeeId        String         @map("employee_id")
  status            DocumentStatus @default(DRAFT)
  variables         Json           @default("{}")               // Snapshot completo dos dados
  employeeSnapshot  Json           @default("{}") @map("employee_snapshot") // Dados do funcionário no momento
  fileStorageId     String?        @map("file_storage_id")
  pdfStorageId      String?        @map("pdf_storage_id")
  dossierFolderId   String?        @map("dossier_folder_id")
  createdBy         String         @map("created_by")
  notes             String?        @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  template        Template         @relation(fields: [templateId], references: [id])
  templateVersion TemplateVersion? @relation(fields: [templateVersionId], references: [id])
  employee        Employee         @relation(fields: [employeeId], references: [id])
  creator         User             @relation("DocumentCreator", fields: [createdBy], references: [id])
  fileStorage     FileStorage?     @relation("DocumentFile", fields: [fileStorageId], references: [id])
  pdfStorage      FileStorage?     @relation("DocumentPdf", fields: [pdfStorageId], references: [id])
  dossierFolder   DossierFolder?   @relation(fields: [dossierFolderId], references: [id])

  @@index([templateId])
  @@index([employeeId])
  @@index([status])
  @@index([createdBy])
  @@map("generated_documents")
}

// ============================================================
// DOSSIÊ DO FUNCIONÁRIO (Explorador de Arquivos)
// ============================================================

model DossierFolder {
  id         String     @id @default(cuid())
  name       String     @db.VarChar(255)
  employeeId String     @map("employee_id")
  parentId   String?    @map("parent_id")
  type       FolderType @default(USER)
  order      Int        @default(0)
  isSystem   Boolean    @default(false) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  employee           Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  parent             DossierFolder?      @relation("FolderHierarchy", fields: [parentId], references: [id])
  children           DossierFolder[]     @relation("FolderHierarchy")
  generatedDocuments GeneratedDocument[]
  files              DossierFile[]

  @@index([employeeId])
  @@index([parentId])
  @@map("dossier_folders")
}

model DossierFile {
  id            String  @id @default(cuid())
  name          String  @db.VarChar(255)
  folderId      String  @map("folder_id")
  fileStorageId String  @map("file_storage_id")
  type          DocumentType @default(OUTRO)
  size          BigInt
  mimeType      String  @map("mime_type") @db.VarChar(100)
  uploadedBy    String  @map("uploaded_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  folder      DossierFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  fileStorage FileStorage   @relation(fields: [fileStorageId], references: [id])

  @@index([folderId])
  @@index([uploadedBy])
  @@map("dossier_files")
}

// ============================================================
// STORAGE (MinIO)
// ============================================================

model FileStorage {
  id           String @id @default(cuid())
  bucket       String @db.VarChar(100)
  key          String @db.VarChar(500)
  originalName String @map("original_name") @db.VarChar(255)
  mimeType     String @map("mime_type") @db.VarChar(100)
  size         BigInt
  checksum     String @db.VarChar(64)
  uploadedBy   String @map("uploaded_by")
  url          String? @db.VarChar(1000)
  metadata     Json   @default("{}")

  createdAt DateTime @default(now()) @map("created_at")

  uploader           User                @relation("FileUploader", fields: [uploadedBy], references: [id])
  templates          Template[]
  templateVersions   TemplateVersion[]
  employeeDocuments  EmployeeDocument[]
  documentsAsFile    GeneratedDocument[] @relation("DocumentFile")
  documentsAsPdf     GeneratedDocument[] @relation("DocumentPdf")
  dossierFiles       DossierFile[]

  @@unique([bucket, key])
  @@index([uploadedBy])
  @@index([mimeType])
  @@map("file_storage")
}

// ============================================================
// GESTÃO DE DOCUMENTOS (Explorador Global)
// ============================================================

model DocumentFolder {
  id          String     @id @default(cuid())
  name        String     @db.VarChar(255)
  parentId    String?    @map("parent_id")
  type        FolderType @default(USER)
  isSystem    Boolean    @default(false) @map("is_system")
  description String?    @db.VarChar(500)
  order       Int        @default(0)
  createdBy   String     @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  parent   DocumentFolder?  @relation("DocFolderHierarchy", fields: [parentId], references: [id])
  children DocumentFolder[] @relation("DocFolderHierarchy")

  @@index([parentId])
  @@index([createdBy])
  @@map("document_folders")
}

// ============================================================
// AUDITORIA
// ============================================================

model AuditLog {
  id           String      @id @default(cuid())
  userId       String?     @map("user_id")
  action       AuditAction
  module       String      @db.VarChar(50)
  entityType   String      @map("entity_type") @db.VarChar(50)
  entityId     String?     @map("entity_id") @db.VarChar(100)
  oldValues    Json?       @map("old_values")
  newValues    Json?       @map("new_values")
  ipAddress    String?     @map("ip_address") @db.VarChar(45)
  userAgent    String?     @map("user_agent") @db.VarChar(500)
  description  String?     @db.VarChar(500)
  success      Boolean     @default(true)
  errorMessage String?     @map("error_message") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation("AuditUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([module])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// CONFIGURAÇÕES DO SISTEMA
// ============================================================

model SystemConfig {
  id    String @id @default(cuid())
  key   String @unique @db.VarChar(100)
  value Json
  description String? @db.VarChar(500)

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_config")
}

// ============================================================
// NOTIFICAÇÕES
// ============================================================

model Notification {
  id         String  @id @default(cuid())
  userId     String  @map("user_id")
  title      String  @db.VarChar(255)
  message    String  @db.VarChar(1000)
  type       String  @db.VarChar(50)
  read       Boolean @default(false)
  readAt     DateTime? @map("read_at")
  metadata   Json    @default("{}")
  employeeId String? @map("employee_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([read])
  @@index([employeeId])
  @@map("notifications")
}

// ============================================================
// COMPLIANCE — REQUISITOS DE TEMPLATE
// ============================================================

model TemplateRequirement {
  id           String       @id @default(cuid())
  templateId   String       @map("template_id")
  documentType DocumentType
  label        String       @db.VarChar(100) // "Carteira de Trabalho"
  description  String?      @db.VarChar(300)
  required     Boolean      @default(true)
  blockGeneration Boolean   @default(true) @map("block_generation")
  order        Int          @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, documentType])
  @@index([templateId])
  @@map("template_requirements")
}

// ============================================================
// COMPLIANCE — VALIDADE DE DOCUMENTOS
// ============================================================

model DocumentValidity {
  id                String         @id @default(cuid())
  employeeId        String         @map("employee_id")
  employeeDocumentId String?       @map("employee_document_id")
  documentType      DocumentType   @map("document_type")
  issueDate         DateTime?      @map("issue_date") @db.Date
  expirationDate    DateTime?      @map("expiration_date") @db.Date
  status            ValidityStatus @default(NOT_APPLICABLE)
  notifiedAt        DateTime?      @map("notified_at")
  notes             String?        @db.VarChar(300)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  employee         Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeDocument EmployeeDocument? @relation(fields: [employeeDocumentId], references: [id])

  @@unique([employeeId, documentType])
  @@index([employeeId])
  @@index([status])
  @@index([expirationDate])
  @@map("document_validity")
}

// ============================================================
// COMPLIANCE — ALERTAS AUTOMÁTICOS
// ============================================================

model Alert {
  id          String        @id @default(cuid())
  type        AlertType
  severity    AlertSeverity @default(WARNING)
  employeeId  String?       @map("employee_id")
  documentType DocumentType? @map("document_type")
  title       String        @db.VarChar(255)
  message     String        @db.VarChar(500)
  metadata    Json          @default("{}")
  resolved    Boolean       @default(false)
  resolvedAt  DateTime?     @map("resolved_at")
  resolvedBy  String?       @map("resolved_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  employee Employee? @relation(fields: [employeeId], references: [id])

  @@index([type])
  @@index([severity])
  @@index([employeeId])
  @@index([resolved])
  @@map("alerts")
}

// ============================================================
// CAMPOS CUSTOMIZADOS DO FUNCIONÁRIO
// ============================================================

model CustomField {
  id           String          @id @default(cuid())
  name         String          @unique @db.VarChar(100) // slug: numero_calcado
  label        String          @db.VarChar(150)         // "Número do Calçado"
  type         CustomFieldType @default(TEXT)
  options      Json?                                    // para SELECT: ["P","M","G","GG"]
  required     Boolean         @default(false)
  active       Boolean         @default(true)
  order        Int             @default(0)
  description  String?         @db.VarChar(300)
  templateVar  String          @map("template_var") @db.VarChar(150) // "custom.numero_calcado"

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  values CustomFieldValue[]

  @@index([active])
  @@map("custom_fields")
}

model CustomFieldValue {
  id            String @id @default(cuid())
  employeeId    String @map("employee_id")
  customFieldId String @map("custom_field_id")
  value         String @db.VarChar(500)

  updatedAt DateTime @updatedAt @map("updated_at")

  employee    Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  customField CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)

  @@unique([employeeId, customFieldId])
  @@index([employeeId])
  @@map("custom_field_values")
}

