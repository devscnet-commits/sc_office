# ============================================================
# SC_OFFICE — variaveis do deploy (docker-compose.prod.yml)
# Copie este arquivo para  .env  (na mesma pasta) e preencha.
#   cp .env.prod.example .env
# ============================================================

# ------------------------------------------------------------
# ONDE o sistema vai responder
# ------------------------------------------------------------
# >>> LOCAL (testar no seu PC): deixe exatamente como esta abaixo
SITE_ADDRESS=:80
PUBLIC_URL=http://localhost
#
# >>> NO SERVIDOR (producao): comente as 2 linhas acima e use estas:
# SITE_ADDRESS=escritorio.scnet.com.br
# PUBLIC_URL=https://escritorio.scnet.com.br
#   (com dominio real + portas 80/443 abertas, o Caddy gera o HTTPS sozinho)

# ------------------------------------------------------------
# SENHAS E SEGREDOS  —  TROQUE TODOS antes de ir para producao
# Gere strings aleatorias (veja DEPLOY.md, passo 1)
# ------------------------------------------------------------
POSTGRES_PASSWORD=troque_esta_senha_do_banco
REDIS_PASSWORD=troque_esta_senha_do_redis

MINIO_ACCESS_KEY=scoffice
MINIO_SECRET_KEY=troque_esta_senha_do_minio

JWT_SECRET=COLE_AQUI_UMA_STRING_ALEATORIA_DE_64_CHARS
REFRESH_TOKEN_SECRET=COLE_AQUI_OUTRA_STRING_ALEATORIA_DE_64_CHARS

# ------------------------------------------------------------
# E-MAIL (opcional) — usado so para "esqueci minha senha".
# Pode deixar em branco por enquanto; o sistema sobe normal.
# ------------------------------------------------------------
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM="SC Office <noreply@scoffice.com>"
